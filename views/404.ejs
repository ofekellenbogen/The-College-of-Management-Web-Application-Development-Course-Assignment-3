<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="app-header">
    <div class="header-container">
      <div class="logo-area">
        <span class="logo-badge">Error 404</span>
        <h1 class="logo-title">עמוד לא נמצא</h1>
      </div>
      <nav class="nav-links">
        <a href="/" class="nav-btn">🎮 חזרה למשחק הראשי</a>
        <a href="/schemas" class="nav-btn">📋 סכמות המערכת</a>
      </nav>
    </div>
  </header>

  <main class="main-container text-center" style="margin-top: 4rem;">
    <section class="glass-panel" style="max-width: 600px; margin: 0 auto; padding: 3rem;">
      <h2 style="font-size: 3rem; margin-bottom: 1rem; color: var(--accent-color);">404</h2>
      <p style="font-size: 1.25rem; margin-bottom: 2rem;">העמוד שחיפשת אינו קיים במערכת.</p>
      <a href="/" class="btn-primary btn-large" style="display: inline-block; text-decoration: none;">חזרה למשחק הראשי 🚀</a>
    </section>
  </main>
</body>
</html>
